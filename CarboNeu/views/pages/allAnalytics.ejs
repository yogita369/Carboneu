<% layout("/layout/boiler") %>

<div class="analytics-list-container">

  <h1><%= user.name.split(" ")[0] %>’s Emission Analytics History</h1>

  <% if (analyticsList.length > 0) { 
      let totalEmissionAllTime = 0;
      let totalCategory = { energy: 0, fuel: 0, travel: 0, food: 0 };

      analyticsList.forEach(i => {
        totalEmissionAllTime += i.totalEmission;
        totalCategory.energy += i.breakdown.energy;
        totalCategory.fuel += i.breakdown.fuel;
        totalCategory.travel += i.breakdown.travel;
        totalCategory.food += i.breakdown.food;
      });
  %>

  <div class="summary-cards">

    <!-- SUMMARY CARD 1 -->
    <div class="summary-card">
      <h2>Total CO₂ Emitted</h2>
      <p class="big-number"><%= totalEmissionAllTime.toFixed(2) %> kg</p>

      <span class="from-date">
        Since: <%= new Date(analyticsList[0].createdAt).toLocaleDateString() %>
      </span>
    </div>

    <!-- SUMMARY CARD 2 (FIXED LAYOUT) -->
    <div class="summary-card">
      <h2>Category Breakdown</h2>

      <div class="category-grid">
        <div class="cat-box">
          <span class="cat-title">Energy</span>
          <span class="cat-value"><%= totalCategory.energy.toFixed(2) %> kg</span>
        </div>

        <div class="cat-box">
          <span class="cat-title">Fuel</span>
          <span class="cat-value"><%= totalCategory.fuel.toFixed(2) %> kg</span>
        </div>

        <div class="cat-box">
          <span class="cat-title">Travel</span>
          <span class="cat-value"><%= totalCategory.travel.toFixed(2) %> kg</span>
        </div>

        <div class="cat-box">
          <span class="cat-title">Food</span>
          <span class="cat-value"><%= totalCategory.food.toFixed(2) %> kg</span>
        </div>
      </div>
    </div>
  </div>

  <% } %>

  <% if (analyticsList.length === 0) { %>
    <p class="empty">No analytics found. Submit your first emission report!</p>
  <% } else { %>

  <div class="cards">
    <% analyticsList.forEach(item => { %>
    <a href="/analytics/<%= item._id %>" class="card">
      
      <h3>Total: <%= item.totalEmission.toFixed(2) %> kg CO₂</h3>

      <p class="highlight-date">
        <strong>Date:</strong> <%= item.createdAt.toLocaleString() %>
      </p>

      <div class="breakdown-mini">

        <div class="cat-box">
          <span class="cat-title">Energy</span>
          <span class="cat-value"><%= item.breakdown.energy.toFixed(2) %></span>
        </div>

        <div class="cat-box">
          <span class="cat-title">Fuel</span>
          <span class="cat-value"><%= item.breakdown.fuel.toFixed(2) %></span>
        </div>

        <div class="cat-box">
          <span class="cat-title">Travel</span>
          <span class="cat-value"><%= item.breakdown.travel.toFixed(2) %></span>
        </div>

        <div class="cat-box">
          <span class="cat-title">Food</span>
          <span class="cat-value"><%= item.breakdown.food.toFixed(2) %></span>
        </div>

      </div>
    </a>
    <% }) %>
  </div>

  <% } %>

</div>


<style>
  .analytics-list-container {
    max-width: 1100px;
    margin: 50px auto;
    padding: 20px;
    text-align: center;
  }

  h1 {
    margin-bottom: 30px;
    color: #333;
  }

  /* Summary cards side by side */
  .summary-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 40px;
  }

  .summary-card {
    background: #f8f9fa;
    border-radius: 12px;
    padding: 25px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    text-align: center;
  }

  .big-number {
    font-size: 28px;
    font-weight: bold;
    color: #28a745;
  }

  .from-date {
    display: block;
    margin-top: 10px;
    color: #555;
    font-size: 14px;
  }

  /* FIXED CATEGORY GRID */
  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px 20px;
    margin-top: 15px;
  }

  .cat-box {
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  .cat-title {
    font-weight: bold;
    font-size: 15px;
    color: #333;
  }

  .cat-value {
    font-size: 14px;
    color: #555;
    margin-top: 3px;
  }

  /* Cards wider (3 per row) */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .card {
    background: #fff;
    border-radius: 12px;
    padding: 20px;
    text-decoration: none;
    color: #333;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    transition: 0.3s ease;
  }

  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 6px 16px rgba(0,0,0,0.15);
  }

  /* Card category style */
  .breakdown-mini {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 12px;
  }

  .highlight-date {
    background: #f8f8a5ac;
    padding: 5px 8px;
    border-radius: 6px;
    margin-bottom: 10px;
    font-size: 13px;
  }

  .empty {
    color: #777;
    font-size: 18px;
    margin-top: 40px;
  }
</style>
