<script>
  const calculateBtn = document.getElementById('submit-btn');
  const backBtn = document.getElementById('submit');

  // ⭐ BACK BUTTON → JUST GO TO DASHBOARD
  backBtn.addEventListener('click', () => {
    window.location.href = "/neutral";   // <-- change if your dashboard route is different
  });

  // ⭐ CALCULATE + SAVE BUTTON
  calculateBtn.addEventListener('click', async (e) => {
    e.preventDefault();

    const activities = {
      plant_trees: Number(document.getElementById('trees')?.value || 0),
      cycled_waste: Number(document.getElementById('waste')?.value || 0),
      composting_organic_waste: Number(document.getElementById('compost')?.value || 0),
      food_skipped_meals: Number(document.getElementById('food')?.value || 0),
      transport_km_saved: Number(document.getElementById('transport')?.value || 0),
      energy_saving: Number(document.getElementById('energy')?.value || 0),
      fuel_saved_liters: Number(document.getElementById('fuel')?.value || 0)
    };

    // remove zero entries
    Object.keys(activities).forEach(k => {
      if (!activities[k] || activities[k] <= 0) delete activities[k];
    });

    if (Object.keys(activities).length === 0) {
      alert('Please enter at least one activity amount greater than 0.');
      return;
    }

    // Disable button temporarily
    calculateBtn.disabled = true;
    calculateBtn.textContent = 'Saving...';

    try {
      const resp = await fetch('/neutral/add-multiple', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ activities })
      });

      const data = await resp.json();
      if (resp.ok && data.success) {
        window.location.href = '/neutral';
      } else {
        alert(data.message || 'Failed to save offsets');
        calculateBtn.disabled = false;
        calculateBtn.textContent = 'Calculate Total Carbon Offset';
      }
    } catch (err) {
      console.error(err);
      alert('Server error while saving offsets.');
      calculateBtn.disabled = false;
      calculateBtn.textContent = 'Calculate Total Carbon Offset';
    }
  });
</script>
