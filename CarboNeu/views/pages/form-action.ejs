<form action="/neutral/reduce-existing" method="POST">

    <div class="activity">
        <div class="activity-icon">🍽️</div>
        <div class="activity-content">
            <div class="activity-title">Food</div>
            <div class="activity-question">"How many meat-based meals did you skip?"</div>
            <div class="activity-inputs">
                <div class="input-group">
                    <input type="number" name="quantity" id="food" min="0" value="0">
                    <input type="hidden" name="activityType" value="food_skipped_meals">
                    <div class="unit">Number of meals</div>
                </div>
                <div class="offset-info">Offset: 2.5 kg CO₂ per meal</div>
                <div class="result" id="food-result">0 kg CO₂</div>
            </div>
        </div>
    </div>

    <div class="activity">
        <div class="activity-icon">🚗</div>
        <div class="activity-content">
            <div class="activity-title">Transport</div>
            <div class="activity-question">"How many km did you NOT drive?"</div>
            <div class="activity-inputs">
                <div class="input-group">
                    <input type="number" name="quantity" id="transport" min="0" value="0">
                    <input type="hidden" name="activityType" value="transport_km_saved">
                    <div class="unit">Distance in kilometers</div>
                </div>
                <div class="offset-info">Offset: 0.21 kg CO₂ per km</div>
                <div class="result" id="transport-result">0 kg CO₂</div>
            </div>
        </div>
    </div>

    <div class="activity">
        <div class="activity-icon">⚡</div>
        <div class="activity-content">
            <div class="activity-title">Energy</div>
            <div class="activity-question">"How many low-energy days did you have?"</div>
            <div class="activity-inputs">
                <div class="input-group">
                    <input type="number" name="quantity" id="energy" min="0" value="0">
                    <input type="hidden" name="activityType" value="energy_saving">
                    <div class="unit">Number of days</div>
                </div>
                <div class="offset-info">Offset: 0.3 kg CO₂ per day</div>
                <div class="result" id="energy-result">0 kg CO₂</div>
            </div>
        </div>
    </div>

    <div class="activity">
        <div class="activity-icon">⛽</div>
        <div class="activity-content">
            <div class="activity-title">Fuel</div>
            <div class="activity-question">"How many liters of fuel did you save?"</div>
            <div class="activity-inputs">
                <div class="input-group">
                    <input type="number" name="quantity" id="fuel" min="0" value="0">
                    <input type="hidden" name="activityType" value="fuel_saved_liters">
                    <div class="unit">Liters of petrol/diesel</div>
                </div>
                <div class="offset-info">Offset: 2.3 kg CO₂ per liter</div>
                <div class="result" id="fuel-result">0 kg CO₂</div>
            </div>
        </div>
    </div>

</form>



        <div class="submit-section">
            <button class="submit-btn" id="submit-btn">Calculate Total Carbon Reduction</button>
        </div>
        
        <div class="total-section" id="total-section">
            <div class="total-title">Congratulations🎉 You have reduced your carbon footprint</div>
            <div class="total-value" id="total-result">0 kg CO₂</div>
        </div>
        
    </div>

    <script>
        // Get all input elements
        const foodInput = document.getElementById('food');
        const transportInput = document.getElementById('transport');
        const energyInput = document.getElementById('energy');
        const fuelInput = document.getElementById('fuel');
        
        // Get all result elements
        const foodResult = document.getElementById('food-result');
        const transportResult = document.getElementById('transport-result');
        const energyResult = document.getElementById('energy-result');
        const fuelResult = document.getElementById('fuel-result');
        
        // Get submit button and total section
        const submitBtn = document.getElementById('submit-btn');
        const totalSection = document.getElementById('total-section');
        const totalResult = document.getElementById('total-result');
        
        // Function to calculate and update individual results
        function calculateIndividualResults() {
            // Get values from inputs, default to 0 if empty
            const foodValue = parseFloat(foodInput.value) || 0;
            const transportValue = parseFloat(transportInput.value) || 0;
            const energyValue = parseFloat(energyInput.value) || 0;
            const fuelValue = parseFloat(fuelInput.value) || 0;
            
            // Calculate individual offsets
            const foodOffset = foodValue * 2.5;
            const transportOffset = transportValue * 0.21;
            const energyOffset = energyValue * 3.0;
            const fuelOffset = fuelValue * 2.3;
            
            // Update result displays
            foodResult.textContent = `${foodOffset.toFixed(2)} kg CO₂`;
            transportResult.textContent = `${transportOffset.toFixed(2)} kg CO₂`;
            energyResult.textContent = `${energyOffset.toFixed(2)} kg CO₂`;
            fuelResult.textContent = `${fuelOffset.toFixed(2)} kg CO₂`;
        }
        
        // Function to calculate and display total offset
        function calculateTotalOffset() {
            // Get individual offsets
            const foodOffset = parseFloat(foodResult.textContent) || 0;
            const transportOffset = parseFloat(transportResult.textContent) || 0;
            const energyOffset = parseFloat(energyResult.textContent) || 0;
            const fuelOffset = parseFloat(fuelResult.textContent) || 0;
            
            // Calculate total offset
            const totalOffset = foodOffset + transportOffset + energyOffset + fuelOffset;
            
            // Update total result display
            totalResult.textContent = `${totalOffset.toFixed(2)} kg CO₂`;
            
            // Show total section with animation
            totalSection.classList.add('show');
        }
        
        // Add event listeners to all inputs for live calculation
        foodInput.addEventListener('input', calculateIndividualResults);
        transportInput.addEventListener('input', calculateIndividualResults);
        energyInput.addEventListener('input', calculateIndividualResults);
        fuelInput.addEventListener('input', calculateIndividualResults);
        
        // Add event listener to submit button
        submitBtn.addEventListener('click', calculateTotalOffset);
        
        // Calculate initial individual results on page load
        calculateIndividualResults();
    </script>


<script>
  const SubmitBtn = document.getElementById('submit-btn');

  submitBtn.addEventListener('click', async (e) => {
    e.preventDefault();

    // Collect quantities from inputs (only positive numbers)
    const activities = {
      plant_trees: Number(document.getElementById('trees')?.value || 0),
      cycled_waste: Number(document.getElementById('waste')?.value || 0), // or 'recycled_waste' if you changed key
      composting_organic_waste: Number(document.getElementById('compost')?.value || 0),
      food_skipped_meals: Number(document.getElementById('food')?.value || 0),
      transport_km_saved: Number(document.getElementById('transport')?.value || 0),
      energy_saving: Number(document.getElementById('energy')?.value || 0),
      fuel_saved_liters: Number(document.getElementById('fuel')?.value || 0)
    };

    // remove zero entries
    Object.keys(activities).forEach(k => {
      if (!activities[k] || activities[k] <= 0) delete activities[k];
    });

    if (Object.keys(activities).length === 0) {
      alert('Please enter at least one activity amount greater than 0.');
      return;
    }

    // Optional: disable button to prevent double-click
    submitBtn.disabled = true;
    submitBtn.textContent = 'Saving...';

    try {
      const resp = await fetch('/neutral/add-multiple', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ activities })
      });

      const data = await resp.json();
      if (resp.ok && data.success) {
        // redirect to neutral page to refresh totals & offsets
        window.location.href = '/neutral';
      } else {
        alert(data.message || 'Failed to save offsets');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Calculate Total Carbon Offset';
      }
    } catch (err) {
      console.error(err);
      alert('Server error while saving offsets.');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Calculate Total Carbon Offset';
    }
  });
</script>
